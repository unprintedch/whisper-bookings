{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du client"
    },
    "client_number": {
      "type": "string",
      "description": "Num\u00e9ro unique du client (XXXXCODE)"
    },
    "agency_id": {
      "type": "string",
      "description": "ID de l'agence, attribution contr\u00f4l\u00e9e c\u00f4t\u00e9 serveur",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "user",
                "data.custom_role": "full_access"
              }
            }
          ]
        }
      }
    },
    "agency_contact_id": {
      "type": "string",
      "description": "Index du contact sp\u00e9cifique au sein de l'agence"
    },
    "contact_name": {
      "type": "string",
      "description": "Nom du contact direct"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Email du contact direct"
    },
    "contact_phone": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone du contact direct"
    },
    "color_hex": {
      "type": "string",
      "description": "Couleur du client (hex)",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "notes": {
      "type": "string",
      "description": "Notes sur le client"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user",
                "data.custom_role": "agency"
              }
            },
            {
              "data.agency_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "data.agency_id": "{{user.data.agency_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}