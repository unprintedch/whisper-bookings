{
  "name": "Room",
  "type": "object",
  "properties": {
    "site_id": {
      "type": "string",
      "description": "ID du site"
    },
    "number": {
      "type": "string",
      "description": "Num\u00e9ro de la tente"
    },
    "name": {
      "type": "string",
      "description": "Nom de la tente"
    },
    "capacity_max": {
      "type": "number",
      "description": "Capacit\u00e9 maximale"
    },
    "type_label": {
      "type": "string",
      "enum": [
        "Single",
        "Double",
        "Triple",
        "Quadruple",
        "Family"
      ],
      "description": "Type bas\u00e9 sur la capacit\u00e9"
    },
    "bed_configuration_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Configurations de lit disponibles"
    },
    "notes": {
      "type": "string",
      "description": "Notes internes",
      "rls": {
        "read": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "user",
                "data.custom_role": "full_access"
              }
            }
          ]
        }
      }
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la photo principale"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Tente active"
    }
  },
  "required": [
    "site_id",
    "number",
    "name",
    "capacity_max",
    "type_label"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    }
  }
}