{
  "name": "Blockout",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "ID de la tente"
    },
    "date_start": {
      "type": "string",
      "format": "date",
      "description": "Date de d\u00e9but du blocage"
    },
    "date_end": {
      "type": "string",
      "format": "date",
      "description": "Date de fin du blocage"
    },
    "reason": {
      "type": "string",
      "description": "Motif du blocage"
    },
    "comment": {
      "type": "string",
      "description": "Commentaire sur le blocage"
    }
  },
  "required": [
    "room_id",
    "date_start",
    "date_end",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    }
  }
}