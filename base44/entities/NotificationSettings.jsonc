{
  "name": "NotificationSettings",
  "type": "object",
  "properties": {
    "email_provider": {
      "type": "string",
      "enum": [
        "native",
        "resend"
      ],
      "default": "native",
      "description": "Fournisseur d'envoi d'email: native (Base44 SendEmail, utilisateurs enregistr\u00e9s) ou resend (cl\u00e9 API Resend, adresses externes)"
    },
    "test_mode": {
      "type": "boolean",
      "default": false,
      "description": "En mode test, les emails sont logg\u00e9s mais pas envoy\u00e9s."
    },
    "notify_client_on_request": {
      "type": "boolean",
      "default": false,
      "description": "Envoyer un email de confirmation au client lorsqu'une demande de r\u00e9servation (status REQUEST) est cr\u00e9\u00e9e."
    },
    "admin_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "default": [],
      "description": "List of admin email addresses to receive notifications (fallback)."
    },
    "site_configs": {
      "type": "array",
      "description": "Per-site email and name configuration",
      "items": {
        "type": "object",
        "properties": {
          "site_name": {
            "type": "string",
            "description": "Site name (e.g. Serengeti, Tarangire)"
          },
          "hotel_name": {
            "type": "string",
            "description": "Display name of the hotel for emails"
          },
          "admin_emails": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            },
            "description": "Admin emails for this site"
          }
        }
      }
    },
    "template_new_booking": {
      "type": "string",
      "description": "Email template for new bookings. Use placeholders like [CLIENT_NAME]."
    },
    "template_update_booking": {
      "type": "string",
      "description": "Email template for updated bookings."
    },
    "template_cancellation": {
      "type": "string",
      "description": "Email template for cancelled bookings."
    },
    "template_rates_request": {
      "type": "string",
      "description": "Email template for rate requests from the public page. Use [CONTACT_NAME] and [CONTACT_EMAIL]."
    },
    "template_client_booking_request": {
      "type": "string",
      "description": "Email template sent to the client when a booking request (status REQUEST) is created. Use [CLIENT_NAME], [HOTEL_NAME], [ROOM_NAME], [CHECKIN_DATE], [CHECKOUT_DATE], [STATUS]."
    },
    "booking_request_confirm_title": {
      "type": "string",
      "default": "Request received",
      "description": "Titre affich\u00e9 sur la page publique apr\u00e8s qu'un client soumet une demande de r\u00e9servation."
    },
    "booking_request_confirm_message": {
      "type": "string",
      "default": "We will get back to you shortly.",
      "description": "Message affich\u00e9 sur la page publique apr\u00e8s qu'un client soumet une demande de r\u00e9servation."
    }
  },
  "required": []
}