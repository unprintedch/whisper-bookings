{
  "name": "PublicAccessSettings",
  "type": "object",
  "properties": {
    "is_password_protected": {
      "type": "boolean",
      "default": false,
      "description": "Activer la protection par mot de passe"
    },
    "access_password_hash": {
      "type": "string",
      "description": "Empreinte SHA-256 sal\u00e9e du mot de passe public : le mot de passe n'est jamais stock\u00e9 en clair"
    },
    "access_password_salt": {
      "type": "string",
      "description": "Sel al\u00e9atoire utilis\u00e9 pour calculer l'empreinte du mot de passe"
    },
    "access_password": {
      "type": "string",
      "description": "Ancien champ en clair, conserv\u00e9 pour la migration uniquement : il est effac\u00e9 d\u00e8s qu'une empreinte existe"
    },
    "allow_public_booking": {
      "type": "boolean",
      "default": false,
      "description": "Autoriser les demandes de r\u00e9servation publiques"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}