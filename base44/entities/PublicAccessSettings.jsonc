{
  "name": "PublicAccessSettings",
  "type": "object",
  "properties": {
    "is_password_protected": {
      "type": "boolean",
      "default": false,
      "description": "Activer la protection par mot de passe"
    },
    "access_password": {
      "type": "string",
      "description": "Mot de passe pour acc\u00e9der \u00e0 la page publique"
    },
    "allow_public_booking": {
      "type": "boolean",
      "default": false,
      "description": "Autoriser les demandes de r\u00e9servation publiques"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}