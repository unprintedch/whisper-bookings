{
  "name": "EmailLog",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID de la r\u00e9servation li\u00e9e"
    },
    "recipient": {
      "type": "string",
      "description": "Adresse email du destinataire"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "admin",
        "agency",
        "client"
      ],
      "description": "Type de destinataire"
    },
    "subject": {
      "type": "string",
      "description": "Sujet de l'email"
    },
    "body": {
      "type": "string",
      "description": "Contenu HTML de l'email"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "new",
        "update",
        "cancellation",
        "rates_request"
      ],
      "description": "Type d'\u00e9v\u00e9nement ayant d\u00e9clench\u00e9 l'email"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "skipped"
      ],
      "default": "sent",
      "description": "Statut d'envoi"
    },
    "error_message": {
      "type": "string",
      "description": "Message d'erreur en cas d'\u00e9chec"
    },
    "client_name": {
      "type": "string",
      "description": "Nom du client (d\u00e9normalis\u00e9 pour affichage)"
    },
    "site_name": {
      "type": "string",
      "description": "Nom du site (d\u00e9normalis\u00e9 pour affichage)"
    }
  },
  "required": [
    "recipient",
    "subject",
    "booking_type",
    "status"
  ]
}