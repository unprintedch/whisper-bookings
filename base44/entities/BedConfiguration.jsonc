{
  "name": "BedConfiguration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Description de la configuration"
    },
    "max_occupancy": {
      "type": "number",
      "description": "Occupation maximale pour cette configuration"
    },
    "sort_order": {
      "type": "number",
      "description": "Ordre d'affichage de la configuration"
    }
  },
  "required": [
    "name",
    "max_occupancy"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    }
  }
}