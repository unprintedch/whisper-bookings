{
  "name": "User",
  "type": "object",
  "properties": {
    "custom_role": {
      "type": "string",
      "enum": [
        "full_access",
        "agency"
      ],
      "default": "agency",
      "description": "R\u00f4le attribu\u00e9 uniquement par un administrateur",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "agency_id": {
      "type": "string",
      "description": "Agence attribu\u00e9e uniquement par un administrateur",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "client_view_mode": {
      "type": "string",
      "enum": [
        "clients",
        "reservations"
      ],
      "description": "Preferred view mode for the Clients page"
    },
    "client_view_column_visibility": {
      "type": "object",
      "description": "Column visibility preferences for the reservations table"
    }
  },
  "required": []
}