{
  "name": "Site",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "enum": [
        "Serengeti",
        "Tarangire"
      ],
      "description": "Nom du site"
    },
    "slug": {
      "type": "string",
      "description": "Identifiant unique du site"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Site actif"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user",
            "data.custom_role": "full_access"
          }
        }
      ]
    }
  }
}