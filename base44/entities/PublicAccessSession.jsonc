{
  "name": "PublicAccessSession",
  "type": "object",
  "properties": {
    "token_hash": {
      "type": "string",
      "description": "Empreinte SHA-256 du jeton al\u00e9atoire, jamais le jeton utilisable",
      "pattern": "^[a-f0-9]{64}$"
    },
    "settings_fingerprint": {
      "type": "string",
      "description": "Lie la session au mot de passe et \u00e0 la protection actuels"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiration de la session publique"
    }
  },
  "required": [
    "token_hash",
    "settings_fingerprint",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}